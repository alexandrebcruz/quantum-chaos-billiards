  RowBox[{
   RowBox[{"\[Phi]", "[", 
    RowBox[{"x", ",", "y"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{
      RowBox[{"-", "b"}], "/", "2"}], ",", 
     RowBox[{"a", "+", 
      RowBox[{"(", 
       RowBox[{"b", "/", "2"}], ")"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "b"}], "}"}], ",", 
   RowBox[{"RegionFunction", "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
      RowBox[{
       RowBox[{"-", 
        SqrtBox[
         RowBox[{"y", 
          RowBox[{"(", 
           RowBox[{"b", "-", "y"}], ")"}]}]]}], "\[LessEqual]", " ", "x", 
       "\[LessEqual]", 
       RowBox[{"a", "+", 
        SqrtBox[
         RowBox[{"y", 
