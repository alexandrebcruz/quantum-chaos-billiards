Cell[CellGroupData[{

Cell[BoxData[{"\"\<curvas de n\[IAcute]vel da \
autofun\[CCedilla]\[ATilde]o\>\"", "\[IndentingNewLine]", 
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{"\[Phi]", "[", 
    RowBox[{"x", ",", "y"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{
      RowBox[{"-", "b"}], "/", "2"}], ",", 
     RowBox[{"a", "+", 
      RowBox[{"(", 
       RowBox[{"b", "/", "2"}], ")"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "b"}], "}"}], ",", 
   RowBox[{"RegionFunction", "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
      RowBox[{
       RowBox[{"-", 
        SqrtBox[
         RowBox[{"y", 
          RowBox[{"(", 
           RowBox[{"b", "-", "y"}], ")"}]}]]}], "\[LessEqual]", " ", "x", 
       "\[LessEqual]", 
       RowBox[{"a", "+", 
        SqrtBox[
         RowBox[{"y", 
          RowBox[{"(", 
           RowBox[{"b", "-", "y"}], ")"}]}]]}]}]}], "]"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.6451249364690714`*^9, 3.64512494081332*^9}, 
   3.645144856855421*^9}],

