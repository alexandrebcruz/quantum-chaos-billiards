Cell[BoxData[{"\"\<defini\[CCedilla]\[ATilde]o da matriz A\>\"", "\
\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", "[", "k_", "]"}], " ", "=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", "b"], 
      RowBox[{
       SubsuperscriptBox["\[Integral]", "0", "a"], 
       RowBox[{
        RowBox[{"\[CurlyPhi]", "[", 
         RowBox[{"x", ",", "y", ",", 
          RowBox[{"1", "+", 
           RowBox[{"Mod", "[", 
            RowBox[{"i", ",", "nM"}], "]"}]}], ",", 
          RowBox[{"1", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"i", "-", 
              RowBox[{"Mod", "[", 
               RowBox[{"i", ",", "nM"}], "]"}]}], ")"}], "/", "mM"}]}]}], 
         "]"}], 
        RowBox[{"Laplacian", "[", 
         RowBox[{
          RowBox[{"\[CurlyPhi]", "[", 
           RowBox[{"x", ",", "y", ",", 
            RowBox[{"1", "+", 
             RowBox[{"Mod", "[", 
              RowBox[{"j", ",", "nM"}], "]"}]}], ",", 
            RowBox[{"1", "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"j", "-", 
                RowBox[{"Mod", "[", 
                 RowBox[{"j", ",", "nM"}], "]"}]}], ")"}], "/", "mM"}]}]}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y"}], "}"}]}], "]"}], 
        RowBox[{"\[DifferentialD]", "x"}], 
        RowBox[{"\[DifferentialD]", "y"}]}]}]}], "+", 
     RowBox[{
      RowBox[{"k", "^", "2"}], 
      RowBox[{
       SubsuperscriptBox["\[Integral]", "0", "b"], 
       RowBox[{
        SubsuperscriptBox["\[Integral]", "0", "a"], 
        RowBox[{
         RowBox[{"\[CurlyPhi]", "[", 
          RowBox[{"x", ",", "y", ",", 
           RowBox[{"1", "+", 
            RowBox[{"Mod", "[", 
             RowBox[{"i", ",", "nM"}], "]"}]}], ",", 
           RowBox[{"1", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"i", "-", 
               RowBox[{"Mod", "[", 
                RowBox[{"i", ",", "nM"}], "]"}]}], ")"}], "/", "mM"}]}]}], 
          "]"}], 
         RowBox[{"\[CurlyPhi]", "[", 
          RowBox[{"x", ",", "y", ",", 
           RowBox[{"1", "+", 
            RowBox[{"Mod", "[", 
             RowBox[{"j", ",", "nM"}], "]"}]}], ",", 
           RowBox[{"1", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"j", "-", 
               RowBox[{"Mod", "[", 
                RowBox[{"j", ",", "nM"}], "]"}]}], ")"}], "/", "mM"}]}]}], 
          "]"}], 
         RowBox[{"\[DifferentialD]", "x"}], 
         RowBox[{"\[DifferentialD]", "y"}]}]}]}]}]}], " ", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      RowBox[{
       RowBox[{"nM", "*", "mM"}], "-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "0", ",", 
      RowBox[{
       RowBox[{"nM", "*", "mM"}], "-", "1"}]}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
