Cell[CellGroupData[{

Cell[BoxData[{"\"\<curvas de n\[IAcute]vel da \
autofun\[CCedilla]\[ATilde]o\>\"", "\[IndentingNewLine]", 
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{"\[Phi]", "[", 
    RowBox[{"x", ",", "y"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "A"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "B"}], "}"}], ",", 
   RowBox[{"RegionFunction", "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"b", "/", "2"}], ")"}], "-", 
        SqrtBox[
         RowBox[{"y", 
          RowBox[{"(", 
           RowBox[{"b", "-", "y"}], ")"}]}]]}], "\[LessEqual]", "x", 
       "\[LessEqual]", 
       RowBox[{"a", "+", 
        RowBox[{"(", 
         RowBox[{"b", "/", "2"}], ")"}], "+", 
        SqrtBox[
         RowBox[{"y", 
          RowBox[{"(", 
           RowBox[{"b", "-", "y"}], ")"}]}]]}]}]}], "]"}]}]}], 
  "]"}]}], "Input",
