Cell[CellGroupData[{

Cell[BoxData[{"\"\<curvas de n\[IAcute]vel da \
autofun\[CCedilla]\[ATilde]o\>\"", "\[IndentingNewLine]", 
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{"\[Phi]1", "[", 
    RowBox[{
     SqrtBox[
      RowBox[{
       RowBox[{"x", "^", "2"}], " ", "+", " ", 
       RowBox[{"y", "^", "2"}]}]], ",", 
     RowBox[{"ArcTan", "[", 
      RowBox[{"y", "/", "x"}], "]"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "a"}], ",", "a"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "a"}], ",", "a"}], "}"}], ",", 
   RowBox[{"RegionFunction", "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "^", "2"}], "+", 
        RowBox[{"y", "^", "2"}]}], "\[LessEqual]", 
       RowBox[{"a", "^", "2"}]}]}], "]"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.6450515663545413`*^9, 3.6450515788372555`*^9}, {
   3.6450517271407375`*^9, 3.645051736693284*^9}, 3.6450590730358987`*^9}],

