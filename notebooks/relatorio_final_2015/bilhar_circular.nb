   RowBox[{
    RowBox[{"\[Phi]1", "[", 
     RowBox[{
      SqrtBox[
       RowBox[{
        RowBox[{"x", "^", "2"}], " ", "+", " ", 
        RowBox[{"y", "^", "2"}]}]], ",", 
      RowBox[{"ArcTan", "[", 
       RowBox[{"y", "/", "x"}], "]"}]}], "]"}], "\[Equal]", " ", "0"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "a"}], ",", "a"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "a"}], ",", "a"}], "}"}], ",", 
   RowBox[{"RegionFunction", "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "^", "2"}], "+", 
        RowBox[{"y", "^", "2"}]}], "\[LessEqual]", 
       RowBox[{"a", "^", "2"}]}]}], "]"}]}]}], "]"}]}], "Input",
