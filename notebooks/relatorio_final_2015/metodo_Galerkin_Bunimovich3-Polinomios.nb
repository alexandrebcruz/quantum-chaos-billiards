Cell[CellGroupData[{

Cell[BoxData[{"\"\<linhas nodais da autofun\[CCedilla]\[ATilde]o\>\"", "\
\[IndentingNewLine]", 
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Phi]", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "\[Equal]", " ", "0"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{
      RowBox[{"-", "b"}], "/", "2"}], ",", 
     RowBox[{"a", "+", 
      RowBox[{"(", 
       RowBox[{"b", "/", "2"}], ")"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "b"}], "}"}], ",", 
   RowBox[{"RegionFunction", "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
      RowBox[{
       RowBox[{"-", 
        SqrtBox[
         RowBox[{"y", 
          RowBox[{"(", 
           RowBox[{"b", "-", "y"}], ")"}]}]]}], "\[LessEqual]", " ", "x", 
       "\[LessEqual]", 
       RowBox[{"a", "+", 
        SqrtBox[
         RowBox[{"y", 
          RowBox[{"(", 
           RowBox[{"b", "-", "y"}], ")"}]}]]}]}]}], "]"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.6451468743908176`*^9, 3.645146949076089*^9}}],

